model RCLadder "A sine source driving 8 RC stages; all capacitors on one ground"
  Parts.Sine sine(f = 50) annotation(Placement(transformation(origin={-350,-44}, extent={{-10,-10},{10,10}})));
  Parts.SignalVoltage source annotation(Placement(transformation(origin={-300,-56}, extent={{-10,-10},{10,10}})));
  Parts.Ground ground annotation(Placement(transformation(origin={360,-2}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r1(R = 10) annotation(Placement(transformation(origin={-250,-56}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r2(R = 10) annotation(Placement(transformation(origin={-200,-16}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r3(R = 10) annotation(Placement(transformation(origin={-150,4}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r4(R = 10) annotation(Placement(transformation(origin={-90,24}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r5(R = 10) annotation(Placement(transformation(origin={-30,40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r6(R = 10) annotation(Placement(transformation(origin={40,52}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r7(R = 10) annotation(Placement(transformation(origin={110,64}, extent={{-10,-10},{10,10}})));
  Parts.Resistor r8(R = 10) annotation(Placement(transformation(origin={190,64}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c1(C = 0.001) annotation(Placement(transformation(origin={-200,-56}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c2(C = 0.001) annotation(Placement(transformation(origin={-150,-36}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c3(C = 0.001) annotation(Placement(transformation(origin={-90,-16}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c4(C = 0.001) annotation(Placement(transformation(origin={-30,0}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c5(C = 0.001) annotation(Placement(transformation(origin={40,12}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c6(C = 0.001) annotation(Placement(transformation(origin={110,24}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c7(C = 0.001) annotation(Placement(transformation(origin={190,24}, extent={{-10,-10},{10,10}})));
  Parts.Capacitor c8(C = 0.001) annotation(Placement(transformation(origin={270,64}, extent={{-10,-10},{10,10}})));
  Parts.VoltageSensor sensor annotation(Placement(transformation(origin={270,-22}, extent={{-10,-10},{10,10}})));
  Parts.Gain scale(k = 0.5) annotation(Placement(transformation(origin={360,-42}, extent={{-10,-10},{10,10}})));
equation
  connect(sine.y, source.v_in) annotation(Line(points={{-339,-44},{-315,-44},{-315,-30},{-300,-30},{-300,-44}}, color={0,0,127}));
  connect(source.n, ground.p) annotation(Line(points={{-290,-56},{-270,-56},{-270,-80},{-135,-80},{-135,-36},{25,-36},{25,-5},{205,-5},{205,24},{360,24},{360,8}}, color={0,0,255}));
  connect(source.p, r1.p) annotation(Line(points={{-310,-56},{-315,-56},{-315,-75},{-265,-75},{-265,-56},{-260,-56}}, color={0,0,255}));
  connect(r1.n, c1.p) annotation(Line(points={{-240,-56},{-210,-56}}, color={0,0,255}));
  connect(c1.n, ground.p) annotation(Line(points={{-190,-56},{-135,-56},{-135,-36},{25,-36},{25,-5},{205,-5},{205,24},{360,24},{360,8}}, color={0,0,255}));
  connect(r1.n, r2.p) annotation(Line(points={{-240,-56},{-215,-56},{-215,-16},{-210,-16}}, color={0,0,255}));
  connect(r2.n, c2.p) annotation(Line(points={{-190,-16},{-165,-16},{-165,-36},{-160,-36}}, color={0,0,255}));
  connect(c2.n, ground.p) annotation(Line(points={{-140,-36},{25,-36},{25,-5},{205,-5},{205,24},{360,24},{360,8}}, color={0,0,255}));
  connect(r2.n, r3.p) annotation(Line(points={{-190,-16},{-165,-16},{-165,4},{-160,4}}, color={0,0,255}));
  connect(r3.n, c3.p) annotation(Line(points={{-140,4},{-105,4},{-105,-16},{-100,-16}}, color={0,0,255}));
  connect(c3.n, ground.p) annotation(Line(points={{-80,-16},{25,-16},{25,-5},{205,-5},{205,24},{360,24},{360,8}}, color={0,0,255}));
  connect(r3.n, r4.p) annotation(Line(points={{-140,4},{-105,4},{-105,24},{-100,24}}, color={0,0,255}));
  connect(r4.n, c4.p) annotation(Line(points={{-80,24},{-45,24},{-45,0},{-40,0}}, color={0,0,255}));
  connect(c4.n, ground.p) annotation(Line(points={{-20,0},{25,0},{25,-5},{205,-5},{205,24},{360,24},{360,8}}, color={0,0,255}));
  connect(r4.n, r5.p) annotation(Line(points={{-80,24},{-45,24},{-45,40},{-40,40}}, color={0,0,255}));
  connect(r5.n, c5.p) annotation(Line(points={{-20,40},{25,40},{25,12},{30,12}}, color={0,0,255}));
  connect(c5.n, ground.p) annotation(Line(points={{50,12},{90,12},{90,45},{360,45},{360,8}}, color={0,0,255}));
  connect(r5.n, r6.p) annotation(Line(points={{-20,40},{25,40},{25,52},{30,52}}, color={0,0,255}));
  connect(r6.n, c6.p) annotation(Line(points={{50,52},{95,52},{95,24},{100,24}}, color={0,0,255}));
  connect(c6.n, ground.p) annotation(Line(points={{120,24},{170,24},{170,45},{360,45},{360,8}}, color={0,0,255}));
  connect(r6.n, r7.p) annotation(Line(points={{50,52},{95,52},{95,64},{100,64}}, color={0,0,255}));
  connect(r7.n, c7.p) annotation(Line(points={{120,64},{175,64},{175,24},{180,24}}, color={0,0,255}));
  connect(c7.n, ground.p) annotation(Line(points={{200,24},{360,24},{360,8}}, color={0,0,255}));
  connect(r7.n, r8.p) annotation(Line(points={{120,64},{180,64}}, color={0,0,255}));
  connect(r8.n, c8.p) annotation(Line(points={{200,64},{260,64}}, color={0,0,255}));
  connect(c8.n, ground.p) annotation(Line(points={{280,64},{360,64},{360,8}}, color={0,0,255}));
  connect(r8.n, sensor.p) annotation(Line(points={{200,64},{255,64},{255,-22},{260,-22}}, color={0,0,255}));
  connect(sensor.n, ground.p) annotation(Line(points={{280,-22},{345,-22},{345,15},{360,15},{360,8}}, color={0,0,255}));
  connect(sensor.v_out, scale.u) annotation(Line(points={{270,-33},{270,-42},{348,-42}}, color={0,0,127}));
  annotation(Diagram(coordinateSystem(extent={{-380,-100},{400,100}})));
end RCLadder;
