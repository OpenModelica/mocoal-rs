model ResistorMesh "24 resistors between the nodes of a 4 x 4 mesh; a source across two corners"
  Parts.ConstantVoltage source(V = 10) annotation(Placement(transformation(origin={-130,80}, extent={{-10,-10},{10,10}}, rotation=270)));
  Parts.Ground ground annotation(Placement(transformation(origin={-80,80}, extent={{-10,-10},{10,10}})));
  Parts.Resistor h11 annotation(Placement(transformation(origin={-30,80}, extent={{-10,-10},{10,10}})));
  Parts.Resistor h12 annotation(Placement(transformation(origin={20,80}, extent={{-10,-10},{10,10}})));
  Parts.Resistor h13 annotation(Placement(transformation(origin={70,80}, extent={{-10,-10},{10,10}})));
  Parts.Resistor h21 annotation(Placement(transformation(origin={120,80}, extent={{-10,-10},{10,10}}, rotation=180)));
  Parts.Resistor h22 annotation(Placement(transformation(origin={-130,40}, extent={{-10,-10},{10,10}}, rotation=270)));
  Parts.Resistor h23 annotation(Placement(transformation(origin={-80,40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor h31 annotation(Placement(transformation(origin={-30,40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor h32 annotation(Placement(transformation(origin={20,40}, extent={{-10,-10},{10,10}}, rotation=270)));
  Parts.Resistor h33 annotation(Placement(transformation(origin={70,40}, extent={{-10,-10},{10,10}}, rotation=270)));
  Parts.Resistor h41 annotation(Placement(transformation(origin={120,40}, extent={{-10,-10},{10,10}}, rotation=270)));
  Parts.Resistor h42 annotation(Placement(transformation(origin={-130,0}, extent={{-10,-10},{10,10}}, rotation=270)));
  Parts.Resistor h43 annotation(Placement(transformation(origin={-80,0}, extent={{-10,-10},{10,10}}, rotation=90)));
  Parts.Resistor v11 annotation(Placement(transformation(origin={-30,0}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v12 annotation(Placement(transformation(origin={20,0}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v13 annotation(Placement(transformation(origin={70,0}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v14 annotation(Placement(transformation(origin={120,0}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v21 annotation(Placement(transformation(origin={-130,-40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v22 annotation(Placement(transformation(origin={-80,-40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v23 annotation(Placement(transformation(origin={-30,-40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v24 annotation(Placement(transformation(origin={20,-40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v31 annotation(Placement(transformation(origin={70,-40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v32 annotation(Placement(transformation(origin={120,-40}, extent={{-10,-10},{10,10}})));
  Parts.Resistor v33 annotation(Placement(transformation(origin={-130,-80}, extent={{-10,-10},{10,10}}, rotation=180)));
  Parts.Resistor v34 annotation(Placement(transformation(origin={-80,-80}, extent={{-10,-10},{10,10}}, rotation=180)));
equation
  connect(h11.p, v11.p) annotation(Line(points={{-40,80},{-40,0}}, color={0,0,255}));
  connect(h11.p, source.p) annotation(Line(points={{-40,80},{-130,90}}, color={0,0,255}));
  connect(h11.n, h12.p) annotation(Line(points={{-20,80},{10,80}}, color={0,0,255}));
  connect(h11.n, v12.p) annotation(Line(points={{-20,80},{10,0}}, color={0,0,255}));
  connect(h12.n, h13.p) annotation(Line(points={{30,80},{60,80}}, color={0,0,255}));
  connect(h12.n, v13.p) annotation(Line(points={{30,80},{60,0}}, color={0,0,255}));
  connect(h13.n, v14.p) annotation(Line(points={{80,80},{110,0}}, color={0,0,255}));
  connect(h21.p, v11.n) annotation(Line(points={{130,80},{-20,0}}, color={0,0,255}));
  connect(h21.p, v21.p) annotation(Line(points={{130,80},{-140,-40}}, color={0,0,255}));
  connect(h21.n, h22.p) annotation(Line(points={{110,80},{-130,50}}, color={0,0,255}));
  connect(h21.n, v12.n) annotation(Line(points={{110,80},{30,0}}, color={0,0,255}));
  connect(h21.n, v22.p) annotation(Line(points={{110,80},{-90,-40}}, color={0,0,255}));
  connect(h22.n, h23.p) annotation(Line(points={{-130,30},{-90,40}}, color={0,0,255}));
  connect(h22.n, v13.n) annotation(Line(points={{-130,30},{80,0}}, color={0,0,255}));
  connect(h22.n, v23.p) annotation(Line(points={{-130,30},{-40,-40}}, color={0,0,255}));
  connect(h23.n, v14.n) annotation(Line(points={{-70,40},{130,0}}, color={0,0,255}));
  connect(h23.n, v24.p) annotation(Line(points={{-70,40},{10,-40}}, color={0,0,255}));
  connect(h31.p, v21.n) annotation(Line(points={{-40,40},{-120,-40}}, color={0,0,255}));
  connect(h31.p, v31.p) annotation(Line(points={{-40,40},{60,-40}}, color={0,0,255}));
  connect(h31.n, h32.p) annotation(Line(points={{-20,40},{20,50}}, color={0,0,255}));
  connect(h31.n, v22.n) annotation(Line(points={{-20,40},{-70,-40}}, color={0,0,255}));
  connect(h31.n, v32.p) annotation(Line(points={{-20,40},{110,-40}}, color={0,0,255}));
  connect(h32.n, h33.p) annotation(Line(points={{20,30},{70,50}}, color={0,0,255}));
  connect(h32.n, v23.n) annotation(Line(points={{20,30},{-20,-40}}, color={0,0,255}));
  connect(h32.n, v33.p) annotation(Line(points={{20,30},{-120,-80}}, color={0,0,255}));
  connect(h33.n, v24.n) annotation(Line(points={{70,30},{30,-40}}, color={0,0,255}));
  connect(h33.n, v34.p) annotation(Line(points={{70,30},{-70,-80}}, color={0,0,255}));
  connect(h41.p, v31.n) annotation(Line(points={{120,50},{80,-40}}, color={0,0,255}));
  connect(h41.n, h42.p) annotation(Line(points={{120,30},{-130,10}}, color={0,0,255}));
  connect(h41.n, v32.n) annotation(Line(points={{120,30},{130,-40}}, color={0,0,255}));
  connect(h42.n, h43.p) annotation(Line(points={{-130,-10},{-80,-10}}, color={0,0,255}));
  connect(h42.n, v33.n) annotation(Line(points={{-130,-10},{-140,-80}}, color={0,0,255}));
  connect(h43.n, v34.n) annotation(Line(points={{-80,10},{-90,-80}}, color={0,0,255}));
  connect(h43.n, source.n) annotation(Line(points={{-80,10},{-130,70}}, color={0,0,255}));
  connect(h43.n, ground.p) annotation(Line(points={{-80,10},{-80,90}}, color={0,0,255}));
  annotation(Diagram(coordinateSystem(extent={{-160,-120},{160,120}})));
end ResistorMesh;
