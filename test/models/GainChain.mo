model GainChain "A constant and 24 gains in a row"
  Parts.Constant c(k = 1);
  Parts.Gain g1(k = 1);
  Parts.Gain g2(k = 2);
  Parts.Gain g3(k = 3);
  Parts.Gain g4(k = 4);
  Parts.Gain g5(k = 5);
  Parts.Gain g6(k = 6);
  Parts.Gain g7(k = 7);
  Parts.Gain g8(k = 8);
  Parts.Gain g9(k = 9);
  Parts.Gain g10(k = 10);
  Parts.Gain g11(k = 11);
  Parts.Gain g12(k = 12);
  Parts.Gain g13(k = 13);
  Parts.Gain g14(k = 14);
  Parts.Gain g15(k = 15);
  Parts.Gain g16(k = 16);
  Parts.Gain g17(k = 17);
  Parts.Gain g18(k = 18);
  Parts.Gain g19(k = 19);
  Parts.Gain g20(k = 20);
  Parts.Gain g21(k = 21);
  Parts.Gain g22(k = 22);
  Parts.Gain g23(k = 23);
  Parts.Gain g24(k = 24);
equation
  connect(c.y, g1.u);
  connect(g1.y, g2.u);
  connect(g2.y, g3.u);
  connect(g3.y, g4.u);
  connect(g4.y, g5.u);
  connect(g5.y, g6.u);
  connect(g6.y, g7.u);
  connect(g7.y, g8.u);
  connect(g8.y, g9.u);
  connect(g9.y, g10.u);
  connect(g10.y, g11.u);
  connect(g11.y, g12.u);
  connect(g12.y, g13.u);
  connect(g13.y, g14.u);
  connect(g14.y, g15.u);
  connect(g15.y, g16.u);
  connect(g16.y, g17.u);
  connect(g17.y, g18.u);
  connect(g18.y, g19.u);
  connect(g19.y, g20.u);
  connect(g20.y, g21.u);
  connect(g21.y, g22.u);
  connect(g22.y, g23.u);
  connect(g23.y, g24.u);
end GainChain;
