model RCLadder "A sine source driving 8 RC stages; all capacitors on one ground"
  Parts.Sine sine(f = 50);
  Parts.SignalVoltage source;
  Parts.Ground ground;
  Parts.Resistor r1(R = 10);
  Parts.Resistor r2(R = 10);
  Parts.Resistor r3(R = 10);
  Parts.Resistor r4(R = 10);
  Parts.Resistor r5(R = 10);
  Parts.Resistor r6(R = 10);
  Parts.Resistor r7(R = 10);
  Parts.Resistor r8(R = 10);
  Parts.Capacitor c1(C = 0.001);
  Parts.Capacitor c2(C = 0.001);
  Parts.Capacitor c3(C = 0.001);
  Parts.Capacitor c4(C = 0.001);
  Parts.Capacitor c5(C = 0.001);
  Parts.Capacitor c6(C = 0.001);
  Parts.Capacitor c7(C = 0.001);
  Parts.Capacitor c8(C = 0.001);
  Parts.VoltageSensor sensor;
  Parts.Gain scale(k = 0.5);
equation
  connect(sine.y, source.v_in);
  connect(source.n, ground.p);
  connect(source.p, r1.p);
  connect(r1.n, c1.p);
  connect(c1.n, ground.p);
  connect(r1.n, r2.p);
  connect(r2.n, c2.p);
  connect(c2.n, ground.p);
  connect(r2.n, r3.p);
  connect(r3.n, c3.p);
  connect(c3.n, ground.p);
  connect(r3.n, r4.p);
  connect(r4.n, c4.p);
  connect(c4.n, ground.p);
  connect(r4.n, r5.p);
  connect(r5.n, c5.p);
  connect(c5.n, ground.p);
  connect(r5.n, r6.p);
  connect(r6.n, c6.p);
  connect(c6.n, ground.p);
  connect(r6.n, r7.p);
  connect(r7.n, c7.p);
  connect(c7.n, ground.p);
  connect(r7.n, r8.p);
  connect(r8.n, c8.p);
  connect(c8.n, ground.p);
  connect(r8.n, sensor.p);
  connect(sensor.n, ground.p);
  connect(sensor.v_out, scale.u);
end RCLadder;
