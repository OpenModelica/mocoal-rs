model ResistorMesh "24 resistors between the nodes of a 4 x 4 mesh; a source across two corners"
  Parts.ConstantVoltage source(V = 10);
  Parts.Ground ground;
  Parts.Resistor h11;
  Parts.Resistor h12;
  Parts.Resistor h13;
  Parts.Resistor h21;
  Parts.Resistor h22;
  Parts.Resistor h23;
  Parts.Resistor h31;
  Parts.Resistor h32;
  Parts.Resistor h33;
  Parts.Resistor h41;
  Parts.Resistor h42;
  Parts.Resistor h43;
  Parts.Resistor v11;
  Parts.Resistor v12;
  Parts.Resistor v13;
  Parts.Resistor v14;
  Parts.Resistor v21;
  Parts.Resistor v22;
  Parts.Resistor v23;
  Parts.Resistor v24;
  Parts.Resistor v31;
  Parts.Resistor v32;
  Parts.Resistor v33;
  Parts.Resistor v34;
equation
  connect(h11.p, v11.p);
  connect(h11.p, source.p);
  connect(h11.n, h12.p);
  connect(h11.n, v12.p);
  connect(h12.n, h13.p);
  connect(h12.n, v13.p);
  connect(h13.n, v14.p);
  connect(h21.p, v11.n);
  connect(h21.p, v21.p);
  connect(h21.n, h22.p);
  connect(h21.n, v12.n);
  connect(h21.n, v22.p);
  connect(h22.n, h23.p);
  connect(h22.n, v13.n);
  connect(h22.n, v23.p);
  connect(h23.n, v14.n);
  connect(h23.n, v24.p);
  connect(h31.p, v21.n);
  connect(h31.p, v31.p);
  connect(h31.n, h32.p);
  connect(h31.n, v22.n);
  connect(h31.n, v32.p);
  connect(h32.n, h33.p);
  connect(h32.n, v23.n);
  connect(h32.n, v33.p);
  connect(h33.n, v24.n);
  connect(h33.n, v34.p);
  connect(h41.p, v31.n);
  connect(h41.n, h42.p);
  connect(h41.n, v32.n);
  connect(h42.n, h43.p);
  connect(h42.n, v33.n);
  connect(h43.n, v34.n);
  connect(h43.n, source.n);
  connect(h43.n, ground.p);
end ResistorMesh;
